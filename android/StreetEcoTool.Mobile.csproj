<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StreetEcoTool.Mobile</RootNamespace>
    <ApplicationTitle>WebView 照片验证</ApplicationTitle>
    <ApplicationId>com.streetecotool.photolab</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <UseMonoRuntime>false</UseMonoRuntime>
    <PublishAot>false</PublishAot>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#075e54" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#075e54" BaseSize="128,128" />
  </ItemGroup>
  <ItemGroup>
    <!-- Intentionally exclude the whole business app: this APK tests ONLY WebView file choice/camera/upload. -->
    <Compile Remove="OfflineHomePage.cs;OfflineHttpServer.cs;OfflineMap.cs;OfflineStoreBridge.cs;MobileApi.cs;ServerPage.cs;probes/**/*.cs" />
    <MauiAsset Include="Resources/Raw/photo-lab.html" LogicalName="photo-lab.html" />
  </ItemGroup>
</Project>
